# Supabase — same project as the Expo app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — same sandbox account
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_APP_ONLY=
STRIPE_PRICE_APP_AND_AGENT=
STRIPE_PRICE_APP_ONLY_RECURRING=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI Whisper
OPENAI_API_KEY=

# Mapbox (public read-only token)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Places — enable Maps JavaScript API + Places API in Google Cloud Console
# https://console.cloud.google.com/ → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Resend — retrieve key from Resend dashboard, verify victoryrevconnect.com domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@victoryrevconnect.com

# App URLs (production: https://victoryrevconnect.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://victoryrevconnect.com

# Vercel cron protection — generate with: openssl rand -hex 32
CRON_SECRET=
