{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "incremental": false,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "app/(app)/garage/page.tsx",
    "components/garage/BoatCard.tsx",
    "components/garage/Logbook.tsx",
    "lib/hooks/useLogbook.ts",
    "lib/hooks/useGarage.ts",
    "app/(app)/garage/[boatId]/diagnose/page.tsx"
  ]
}
