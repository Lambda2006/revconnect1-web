# Supabase — public keys (safe to expose in app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — service role key (server-side API routes ONLY, never in app bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe — public key (safe to expose in app bundle)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe — secret key (server-side API routes ONLY)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe — Product / Price IDs (created in Stripe sandbox)
STRIPE_PRICE_APP_ONLY=price_...        # $4.99 one-time (invoice item at trial end)
STRIPE_PRICE_APP_AND_AGENT=price_...   # $9.99/month recurring
STRIPE_PRICE_APP_ONLY_RECURRING=price_...  # $0/month tracking (app_only subscriptions)

# Anthropic (server-side API routes ONLY)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Whisper (server-side API routes ONLY)
OPENAI_API_KEY=sk-...

# Mapbox (public token — read-only, safe in app bundle)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Mapbox — secret download token (build time only, never in app bundle)
MAPBOX_SECRET_TOKEN=sk.eyJ1...

# Resend (server-side API routes ONLY)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@victoryrevconnect.com

# App URL (used in emails and webhook registration)
NEXT_PUBLIC_APP_URL=https://boat.victoryrevconnect.com
NEXT_PUBLIC_SITE_URL=https://victoryrevconnect.com

# Vercel cron secret — authorizes /api/trial-reminders cron calls
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret
